[submodule "navmeshes"]
    path = navmeshes
    url = https://github.com/LandSandBoat/xiNavmeshes.git
[submodule "losmeshes"]
    path = losmeshes
    url = https://github.com/LandSandBoat/losmeshes.git
[submodule "ximeshes"]
    path = ximeshes
    url = https://github.com/InoUno/ximeshes.git
[submodule "control"]
	path = control
	url = https://github.com/CatsAndBoats/catseyexi-control
[submodule "modules/catseyexi"]
	path = modules/catseyexi
	url = https://github.com/catsandboats/modules
	ignore = all
[submodule "src/map/cexi"]
	path = src/map/cexi
	url = https://github.com/catsandboats/cexi-src